{
  "name": "cafe3rasa-backend",
  "version": "1.0.0",
  "description": "Backend REST API and Real-Time WebSocket Server for Cafe 3 Rasa POS & E-Menu",
  "main": "dist/server.js",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts",
    "deploy:prepare": "prisma generate && tsc",
    "generate": "prisma generate",
    "seed:js": "node dist-seed/seed.js"
  },
  "keywords": [
    "cafe-3-rasa",
    "express",
    "typescript",
    "prisma",
    "socket.io",
    "pos"
  ],
  "author": "Maharewa",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "6.19.3",
    "@prisma/client": "6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
