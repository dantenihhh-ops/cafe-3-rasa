// engineType "client": tanpa mesin Rust (query compiler WebAssembly + driver MariaDB).
// Hemat proses/thread — wajib di hosting bersama yang membatasi jumlah proses.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

// Database: MySQL / MariaDB (hosting cPanel tkj3a.my.id)
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  KASIR
  ADMIN
}

enum TableStatus {
  KOSONG
  BARU_PESAN
  TERISI_BELUM_BAYAR
  TERISI_LUNAS
}

// Alur pesanan (terpisah dari status bayar):
// MENUNGGU_KONFIRMASI -> DIPROSES (dimasak) -> DISAJIKAN (sudah diantar ke meja)
// SELESAI = sudah disajikan DAN sudah lunas
enum OrderStatus {
  MENUNGGU_KONFIRMASI
  DIPROSES
  DISAJIKAN
  SELESAI
  DIBATALKAN
}

enum PaymentBillStatus {
  BELUM_BAYAR
  LUNAS
}

// Sesuai konsep: pembayaran hanya Cash dan Transfer
enum PaymentMethod {
  BELUM_DIPILIH
  CASH
  TRANSFER
}

enum OrderSource {
  EMENU
  KASIR
}

enum ServiceRequestType {
  PANGGIL_PELAYAN
  MINTA_BILL
  MINTA_ALAT_MAKAN
  LAINNYA
}

enum ServiceRequestStatus {
  MENUNGGU
  DIKONFIRMASI
  SELESAI
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(KASIR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Table {
  id             Int              @id @default(autoincrement())
  number         String           @unique
  area           String           @default("Indoor")
  capacity       Int              @default(4)
  status         TableStatus      @default(KOSONG)
  activeSince    DateTime?
  currentOrderId String?          @unique
  currentOrder   Order?           @relation("TableCurrentOrder", fields: [currentOrderId], references: [id], onDelete: SetNull)
  orders         Order[]          @relation("TableOrders")
  requests       ServiceRequest[]
  reviews        Review[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("tables")
}

model Category {
  id           String     @id @default(cuid())
  name         String     @unique
  slug         String     @unique
  displayOrder Int        @default(0)
  menuItems    MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("categories")
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price       BigInt
  image       String?     @db.VarChar(500)
  description String      @default("") @db.VarChar(500)
  isAvailable Boolean     @default(true)
  // Array label (mis. ["Best Seller"]) disimpan sebagai JSON karena MySQL tidak punya tipe array
  filters     Json?
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("menu_items")
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  tableId           Int
  table             Table             @relation("TableOrders", fields: [tableId], references: [id])
  status            OrderStatus       @default(MENUNGGU_KONFIRMASI)
  paymentBillStatus PaymentBillStatus @default(BELUM_BAYAR)
  paymentMethod     PaymentMethod     @default(BELUM_DIPILIH)
  orderSource       OrderSource       @default(EMENU)
  customerNotes     String?           @db.VarChar(500)
  subtotal          BigInt            @default(0)
  tax               BigInt            @default(0)
  total             BigInt            @default(0)
  confirmedAt       DateTime?
  paidAt            DateTime?
  items             OrderItem[]
  currentForTable   Table?            @relation("TableCurrentOrder")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // SetNull: menu boleh dihapus admin tanpa merusak riwayat pesanan
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  // Nama, kategori & harga disalin saat memesan (snapshot) agar laporan tetap akurat
  name         String
  categoryName String
  unitPrice    BigInt
  quantity     Int
  note         String?   @db.VarChar(255)
  subtotal     BigInt
  createdAt    DateTime  @default(now())

  @@map("order_items")
}

model ServiceRequest {
  id              String               @id @default(cuid())
  tableId         Int
  table           Table                @relation(fields: [tableId], references: [id], onDelete: Cascade)
  type            ServiceRequestType   @default(PANGGIL_PELAYAN)
  message         String?              @db.VarChar(500)
  status          ServiceRequestStatus @default(MENUNGGU)
  responseMessage String?              @db.VarChar(500)
  confirmedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("service_requests")
}

model Review {
  id        String   @id @default(cuid())
  tableId   Int
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  rating    Int
  aspects   Json?
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@map("reviews")
}
