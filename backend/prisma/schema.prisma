generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  KASIR
  ADMIN
}

enum TableStatus {
  KOSONG
  BARU_PESAN
  TERISI_BELUM_BAYAR
  TERISI_LUNAS
}

enum OrderStatus {
  MENUNGGU_KONFIRMASI
  DIPROSES
  SELESAI
  DIBATALKAN
}

enum PaymentBillStatus {
  BELUM_BAYAR
  LUNAS
}

enum PaymentMethod {
  BELUM_DIPILIH
  CASH
  TRANSFER
  QRIS
}

enum OrderSource {
  EMENU
  KASIR
}

enum ServiceRequestType {
  PANGGIL_PELAYAN
  MINTA_BILL
  PERTANYAAN
  LAINNYA
}

enum ServiceRequestStatus {
  MENUNGGU
  DIKONFIRMASI
  SELESAI
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(KASIR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Table {
  id             Int              @id @default(autoincrement())
  number         String           @unique
  capacity       Int              @default(4)
  status         TableStatus      @default(KOSONG)
  activeSince    DateTime?
  currentOrderId String?          @unique
  currentOrder   Order?           @relation("TableCurrentOrder", fields: [currentOrderId], references: [id])
  orders         Order[]          @relation("TableOrders")
  requests       ServiceRequest[]
  reviews        Review[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("tables")
}

model Category {
  id           String     @id @default(cuid())
  name         String     @unique
  slug         String     @unique
  displayOrder Int        @default(0)
  menuItems    MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("categories")
}

model MenuItem {
  id           String      @id
  name         String
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  price        BigInt
  image        String?
  description  String      @default("")
  isAvailable  Boolean     @default(true)
  filters      String[]    @default([])
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("menu_items")
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  tableId           Int
  table             Table             @relation("TableOrders", fields: [tableId], references: [id])
  status            OrderStatus       @default(MENUNGGU_KONFIRMASI)
  paymentBillStatus PaymentBillStatus @default(BELUM_BAYAR)
  paymentMethod     PaymentMethod     @default(BELUM_DIPILIH)
  orderSource       OrderSource       @default(EMENU)
  customerNotes     String?
  subtotal          BigInt            @default(0)
  confirmedAt       DateTime?
  paidAt            DateTime?
  items             OrderItem[]
  currentForTable   Table?            @relation("TableCurrentOrder")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("orders")
}

model OrderItem {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id])
  name         String
  categoryName String
  unitPrice    BigInt
  quantity     Int
  note         String?
  subtotal     BigInt
  createdAt    DateTime  @default(now())

  @@map("order_items")
}

model ServiceRequest {
  id              String               @id @default(cuid())
  tableId         Int
  table           Table                @relation(fields: [tableId], references: [id])
  type            ServiceRequestType   @default(PANGGIL_PELAYAN)
  message         String?
  status          ServiceRequestStatus @default(MENUNGGU)
  responseMessage String?
  confirmedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("service_requests")
}

model Review {
  id        String   @id @default(cuid())
  tableId   Int
  table     Table    @relation(fields: [tableId], references: [id])
  rating    Int
  aspects   String[] @default([])
  comment   String?
  createdAt DateTime @default(now())

  @@map("reviews")
}
