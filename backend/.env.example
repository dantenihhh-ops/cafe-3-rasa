# Salin file ini menjadi ".env" lalu isi nilainya. File .env TIDAK ikut ke GitHub.

# ── Server ───────────────────────────────────────────────────────────────
# Di hosting cPanel, PORT diatur otomatis oleh "Setup Node.js App" (biarkan baris ini)
PORT=5000
NODE_ENV=development

# Origin yang boleh mengakses API (pisahkan dengan koma), atau * untuk semua
CORS_ORIGIN=*

# ── Autentikasi ──────────────────────────────────────────────────────────
# WAJIB diisi string acak panjang. Buat dengan perintah:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Aturan Bisnis ────────────────────────────────────────────────────────
# Pajak restoran PB1 dalam persen. Cafe 3 Rasa: tanpa pajak (0)
TAX_RATE_PERCENT=0

# ── Database (MySQL / MariaDB) ───────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:3306/NAMA_DATABASE
#
# Di hosting (backend jalan di server yang sama dengan database):
#   DATABASE_URL="mysql://tkjh1984_kel7:[PASSWORD]@localhost:3306/tkjh1984_kel7"
#
# Simbol di password harus diubah ke format URL: ! -> %21, @ -> %40, # -> %23, / -> %2F
DATABASE_URL="mysql://[USER]:[PASSWORD]@localhost:3306/[NAMA_DATABASE]"

# ── Debug ──────────────────────────────────────────────────────────────
# Tampilkan setiap query SQL di terminal (true/false)
PRISMA_LOG_QUERIES=false

# ── Seed (opsional) ──────────────────────────────────────────────────────
# Password awal akun saat menjalankan "npm run seed". Ganti setelah login pertama.
SEED_KASIR_PASSWORD=kasir123
SEED_ADMIN_PASSWORD=admin123
