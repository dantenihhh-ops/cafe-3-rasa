# Salin file ini menjadi ".env" lalu isi nilainya. File .env TIDAK ikut ke GitHub.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Origin yang boleh mengakses API (pisahkan dengan koma), atau * untuk semua
CORS_ORIGIN=*

# ── Autentikasi ──────────────────────────────────────────────────────────
# WAJIB diisi string acak panjang. Buat dengan perintah:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Aturan Bisnis ────────────────────────────────────────────────────────
# Pajak restoran PB1 dalam persen. Cafe 3 Rasa: tanpa pajak (0)
TAX_RATE_PERCENT=0

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────
# Ambil dari Supabase: Project Settings > Database > Connection string
# DATABASE_URL = Transaction pooler (port 6543), dipakai aplikasi saat berjalan
# DIRECT_URL   = Session pooler (port 5432), dipakai Prisma untuk db push / migrasi
# Ganti [YOUR-PASSWORD] dengan password database Supabase
DATABASE_URL="postgresql://postgres.xuflmboczqpxbzqhikow:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xuflmboczqpxbzqhikow:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Seed (opsional) ──────────────────────────────────────────────────────
# Password awal akun saat menjalankan "npm run seed". Ganti setelah login pertama.
SEED_KASIR_PASSWORD=kasir123
SEED_ADMIN_PASSWORD=admin123
